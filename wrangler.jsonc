// Cloudflare Workers settings for kitchenstudioapp.co: a plain static site, plus worker.js, which
// writes the recipe's name and photo into share pages (/r/<code>, /c/<code>) so link previews in
// Messages show them. Every other address is handed straight to the files (env.ASSETS).
// run_worker_first is a plain true/false: Cloudflare's builds use a Wrangler that refuses a list.
{
  "name": "kitchenstudio-legal",
  "compatibility_date": "2026-11-23",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
